# Copy to a host-only secret environment file; never commit the filled file.
ERP_RUNTIME_ENV=production
ERP_API_HOST=127.0.0.1
ERP_API_PORT=3000

ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=3306
ERP_DB_NAME=yuezi
ERP_DB_USER=yuezi_app
# Required: inject from the host secret store.
ERP_DB_PASSWORD=
ERP_DB_CONNECT_TIMEOUT=5
ERP_DB_READ_TIMEOUT=30
ERP_DB_WRITE_TIMEOUT=30

# Required for a remote production database.
ERP_DB_SSL_CA=
ERP_DB_SSL_CERT=
ERP_DB_SSL_KEY=

# Required: inject at least 32 random bytes from the host secret store.
ERP_TOKEN_SECRET=
ERP_CORS_ORIGINS=https://erp.example.com
ERP_REQUIRE_CURRENT_SCHEMA=true
ERP_ALLOW_QUERY_TOKEN=false
ERP_MAX_REQUEST_BYTES=1048576
ERP_LOGIN_MAX_FAILURES=5
ERP_LOGIN_LOCK_MINUTES=15
