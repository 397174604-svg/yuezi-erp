page{background:#fbf7f0;color:#2b2620;font-family:Noto Sans SC,-apple-system,PingFang SC,sans-serif;font-size:28rpx;line-height:1.6}.yz-card{background:#fff;border:1rpx solid rgba(184,148,90,.28);border-radius:32rpx;padding:28rpx;box-shadow:0 20rpx 60rpx -36rpx rgba(74,56,24,.45)}.yz-serif{font-family:Cormorant Garamond,"Noto Serif SC",serif;color:#8c6a36}.yz-tag{font-size:21rpx;padding:8rpx 16rpx;border-radius:40rpx;border:1rpx solid rgba(184,148,90,.55);color:#8c6a36}.yz-tag--solid{background:linear-gradient(135deg,#e9d4a4,#9c7838);color:#fff;border:none}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}