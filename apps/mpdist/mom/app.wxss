page{background:#faf9f6;background-image:linear-gradient(180deg,rgba(255,255,255,.86),rgba(241,239,234,.38));color:#272521;font-family:Noto Sans SC,-apple-system,PingFang SC,sans-serif;font-size:28rpx;line-height:1.6}.screen>.topbar,.screen>.dhead,.page>.topbar,.page>.top{padding-top:calc(var(--status-bar-height, 0px) + 36rpx)!important;box-sizing:border-box}.yz-card{background:rgba(255,255,255,.96);border:1rpx solid rgba(135,109,62,.2);border-radius:32rpx;padding:28rpx;box-shadow:0 20rpx 60rpx -38rpx rgba(66,58,44,.32)}.yz-serif{font-family:Cormorant Garamond,"Noto Serif SC",serif;color:#876d3e}.yz-tag{font-size:21rpx;padding:8rpx 16rpx;border-radius:40rpx;border:1rpx solid rgba(135,109,62,.42);color:#876d3e}.yz-tag--solid{background:linear-gradient(135deg,#f3e8d2,#d4bb87 48%,#a8874d);color:#fff;border:none}.yz-platinum{background:linear-gradient(135deg,#fff,#ece9e2 52%,#d2cdc4);border:1rpx solid #D8D4CC;box-shadow:0 20rpx 60rpx -38rpx rgba(66,58,44,.32)}.yz-foil{background:linear-gradient(135deg,#f3e8d2,#d4bb87 48%,#a8874d);color:#fff}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}